import std.core.{list, text, tuple} using;

public struct FormField {
  key: string,
  value: string
}

fn hexCharToInt(c: char) -> int {
  (if (c >= '0' && c <= '9') { (c - '0') } else { 0 }) +
  (if (c >= 'a' && c <= 'f') { (c - ('a' - 10)) } else { 0 }) +
  (if (c >= 'A' && c <= 'F') { (c - ('A' - 10)) } else { 0 })
}

fn urlDecodeHelper(str: string, idx: int, res: string) -> string {
  (
    if (idx >= str.length()) {
      res
    } else if (str[idx] == '+') {
      urlDecodeHelper(str, idx + 1, res.appendChar(' '))
    } else if (str[idx] == '%' && idx + 2 < str.length()) {
      (
        hi = hexCharToInt(str[idx + 1]);
        lo = hexCharToInt(str[idx + 2]);
        urlDecodeHelper(str, idx + 3, res.appendChar(char(hi * 16 + lo)))
      )
    } else {
      urlDecodeHelper(str, idx + 1, res.appendChar(str[idx]))
    }
  )
}

public fn urlDecode(input: string) -> string {
  urlDecodeHelper(input, 0, "")
}

public fn parseFormPair(pair: string) -> FormField {
  idx = pair.indexOf("=");
  if idx < 0 { FormField(pair.urlDecode(), "") } else { FormField(pair[0, idx].urlDecode(), pair[++idx, pair.length()].urlDecode()) }
}

public fn parseFormFields(input: string) -> List<FormField> {
  input
    .split(equals<char>['&'])
    .filter([](part: string) -> bool { part.length() > 0 })
    .map(parseFormPair)
}

public fn queryString(resource: string) -> string {
  idx = resource.indexOf("?");
  if idx < 0 { "" } else { resource[++idx, resource.length()] }
}

public fn pathWithoutQuery(resource: string) -> string {
  idx = resource.indexOf("?");
  if idx < 0 { resource } else { resource[0, idx] }
}

public fn queryFields(resource: string) -> List<FormField> {
  resource.queryString().parseFormFields()
}

public fn formValue(fields: List<FormField>, key: string) -> Option<string> {
  fields
    .first([key] (field: FormField) -> bool { field.key == key })
    .map([](field: FormField) -> string { field.value })
}
