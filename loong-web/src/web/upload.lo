import web.context using;
import web.form using;
import web.http using;
import web.http_statuscode using;
import web.http_response using;
import web.json using;
import std.io.file using;
import std.io.path using;
import std.sys.rt using;

public struct UploadMeta {
  filename: string,
  contentType: string,
  size: int,
  url: string
}

public fn uploadFilename(ctx: RouteContext) -> string {
  fields = ctx.path.queryFields();
  fields.formValue("filename") ?? "upload.bin"
}

public fn uploadContentType(ctx: RouteContext) -> string {
  ctx.headers.httpHeaderValue("Content-Type") ?? "application/octet-stream"
}

public fn uploadMeta(ctx: RouteContext) -> UploadMeta {
  UploadMeta(ctx.uploadFilename(), ctx.uploadContentType(), ctx.body.length(), "")
}

impure fn uploadsDir() -> Path {
  pathAbsolute(pathRel() / "data" / "uploads")
}

impure fn saveUpload(filename: string, contentType: string, body: string) -> UploadMeta {
  dir = uploadsDir();
  if (!fileDirExists(dir)) {
    fileCreateDir(dir)
  };
  filePath = dir / filename;
  fileWrite(filePath, body);
  UploadMeta(filename, contentType, body.length(), "/uploads/" + filename)
}
